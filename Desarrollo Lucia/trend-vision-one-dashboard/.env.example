APP_ENV=development
APP_DEBUG=false
APP_DEMO_MODE=true
APP_BACKEND_HOST=127.0.0.1
APP_BACKEND_PORT=8001
APP_STREAMLIT_HOST=127.0.0.1
APP_STREAMLIT_PORT=8501
APP_CACHE_TTL_MINUTES=30
APP_DB_PATH=data/trend_dashboard.db
APP_LOG_LEVEL=INFO

# Regional API domain. Leave empty to derive from APP_REGION.
APP_REGION=us
TREND_VISION_ONE_BASE_URL=
TREND_VISION_ONE_API_TOKEN=
TREND_VISION_ONE_TIMEOUT_SECONDS=30
TREND_VISION_ONE_MAX_RETRIES=4
TREND_VISION_ONE_BACKOFF_SECONDS=1.5
TREND_VISION_ONE_USER_AGENT=trend-vision-one-dashboard/0.1.0
TREND_VISION_ONE_DEFAULT_PAGE_SIZE=100
TREND_VISION_ONE_MAX_PAGES=10
TREND_VISION_ONE_ENDPOINT_INVENTORY_MAX_PAGES=25
TREND_VISION_ONE_COLLECTION_MAX_DURATION_SECONDS=360

# Optional exact endpoint overrides. Keep blank until validated in your tenant's
# Automation Center / API Reference for the configured region.
TREND_VISION_ONE_USERS_PATH=/v3.0/accounts
TREND_VISION_ONE_ENDPOINTS_PATH=/v3.0/endpointSecurity/endpoints
TREND_VISION_ONE_RISK_INSIGHTS_PATH=
TREND_VISION_ONE_CONNECTED_PRODUCTS_PATH=
TREND_VISION_ONE_WORKBENCH_ALERTS_PATH=/v3.0/workbench/alerts
TREND_VISION_ONE_WORKBENCH_ALERTS_MAX_DURATION_SECONDS=180
TREND_VISION_ONE_OAT_DETECTIONS_MAX_DURATION_SECONDS=240
TREND_VISION_ONE_SEARCH_PATH=/v3.0/search
TREND_VISION_ONE_ENDPOINT_INVENTORY_ORDER_BY=
TREND_VISION_ONE_ENDPOINT_INVENTORY_SELECT=
TREND_VISION_ONE_ENDPOINT_INVENTORY_FILTER=
TREND_VISION_ONE_EIQS_ENDPOINTS_PATH=/v3.0/eiqs/endpoints
TREND_VISION_ONE_EIQS_ENDPOINTS_QUERY=

# JumpCloud API credentials
JUMPCLOUD_BASE_URL=https://console.jumpcloud.com/api
JUMPCLOUD_CLIENT_ID=
JUMPCLOUD_CLIENT_SECRET=
JUMPCLOUD_ACCESS_TOKEN=

# Optional local override for the UI. If empty, start_ui.sh derives it from
# APP_BACKEND_PORT.
BACKEND_URL=
