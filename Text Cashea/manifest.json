{
  "manifest_version": 3,
  "name": "Text Cashea",
  "version": "0.1.0",
  "key": "",
  "description": "Expansor de snippets de texto: definí atajos (ej. /firma) y expandilos en cualquier campo editable del navegador.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["src/content/google-docs.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
