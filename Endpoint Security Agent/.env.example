# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ─── Trend Vision One ─────────────────────────────────────────────────────────
# Region: au | eu | in | jp | sg | mea | uk | us | usgov
APP_REGION=us
# Leave blank to derive base URL from APP_REGION
TREND_VISION_ONE_BASE_URL=
TREND_VISION_ONE_API_TOKEN=

# HTTP client behaviour
TREND_VISION_ONE_TIMEOUT_SECONDS=30
TREND_VISION_ONE_MAX_RETRIES=4
TREND_VISION_ONE_BACKOFF_SECONDS=1.5
TREND_VISION_ONE_USER_AGENT=endpoint-security-agent/0.1.0
TREND_VISION_ONE_DEFAULT_PAGE_SIZE=100
TREND_VISION_ONE_MAX_PAGES=10
TREND_VISION_ONE_ENDPOINT_INVENTORY_MAX_PAGES=25
TREND_VISION_ONE_COLLECTION_MAX_DURATION_SECONDS=360

# Endpoint paths (leave blank to use defaults)
TREND_VISION_ONE_USERS_PATH=/v3.0/accounts
TREND_VISION_ONE_ENDPOINTS_PATH=/v3.0/endpointSecurity/endpoints
TREND_VISION_ONE_RISK_INSIGHTS_PATH=
TREND_VISION_ONE_CONNECTED_PRODUCTS_PATH=
TREND_VISION_ONE_SEARCH_PATH=/v3.0/search
TREND_VISION_ONE_EIQS_ENDPOINTS_PATH=/v3.0/eiqs/endpoints
TREND_VISION_ONE_EIQS_ENDPOINTS_QUERY=

# Endpoint inventory filters
TREND_VISION_ONE_ENDPOINT_INVENTORY_ORDER_BY=
TREND_VISION_ONE_ENDPOINT_INVENTORY_SELECT=
TREND_VISION_ONE_ENDPOINT_INVENTORY_FILTER=

# Workbench alerts
TREND_VISION_ONE_WORKBENCH_ALERTS_PATH=/v3.0/workbench/alerts
TREND_VISION_ONE_WORKBENCH_ALERTS_LOOKBACK_HOURS=24
TREND_VISION_ONE_WORKBENCH_ALERTS_DATE_TIME_TARGET=createdDateTime
TREND_VISION_ONE_WORKBENCH_ALERTS_ORDER_BY=createdDateTime desc
TREND_VISION_ONE_WORKBENCH_ALERTS_FILTER=
TREND_VISION_ONE_WORKBENCH_ALERTS_MAX_DURATION_SECONDS=180

# OAT detections
TREND_VISION_ONE_OAT_DETECTIONS_PATH=/v3.0/oat/detections
TREND_VISION_ONE_OAT_DETECTIONS_LOOKBACK_HOURS=24
TREND_VISION_ONE_OAT_DETECTIONS_ORDER_BY=detectedDateTime desc
TREND_VISION_ONE_OAT_DETECTIONS_MAX_PAGES=2
TREND_VISION_ONE_OAT_DETECTIONS_MAX_DURATION_SECONDS=240

# ─── JumpCloud ────────────────────────────────────────────────────────────────
JUMPCLOUD_BASE_URL=https://console.jumpcloud.com/api
JUMPCLOUD_CLIENT_ID=
JUMPCLOUD_CLIENT_SECRET=
JUMPCLOUD_ACCESS_TOKEN=

# ─── AI Agent (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model to use for analysis (e.g. claude-sonnet-4-6, claude-haiku-4-5-20251001)
AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS=4096

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Monitor service ──────────────────────────────────────────────────────────
# How often to poll the APIs (seconds)
MONITOR_POLL_INTERVAL_SECONDS=300
# Path to write monitor state / events
MONITOR_STATE_PATH=data/monitor_state.json
